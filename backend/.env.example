# ═══════════════════════════════════════════════════════════════════════════
# Namaste India — Backend environment variables
# Copy to .env and fill EVERY value:  cp .env.example .env
# NEVER commit .env to git. The server refuses to boot if required vars are missing.
#
# ⚠️  SECURITY NOTICE (2026-09-25): a previous version of this file contained
# REAL production keys. Those keys are compromised — ROTATE them now:
#   • Supabase: dashboard → Project Settings → API → roll the service_role key
#   • MSG91: control.msg91.com → API → regenerate the auth key
# ═══════════════════════════════════════════════════════════════════════════

PORT=5000
NODE_ENV=development

# ─── Supabase (REQUIRED) ────────────────────────────────────────────────────
# Project URL — public, also injected into the Flutter app via --dart-define.
SUPABASE_URL=https://your-project.supabase.co
# Service Role key — SECRET. Server-side only. NEVER expose to any client.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_REPLACE_WITH_YOUR_SERVICE_ROLE_KEY

# ─── MongoDB (REQUIRED) ─────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/namaste_india

# ─── Password-derivation salt (REQUIRED) ────────────────────────────────────
# SECRET. Generate once and never change it (changing it locks out all users):
#   openssl rand -hex 32
USER_SALT=REPLACE_WITH_openssl_rand_-hex_32_OUTPUT

# ─── MSG91 OTP (REQUIRED unless MOCK_OTP=true) ──────────────────────────────
# SECRET. Server-side only — these must NEVER appear in the Flutter app.
MSG91_AUTH_TOKEN=REPLACE_WITH_YOUR_MSG91_AUTH_TOKEN
MSG91_WIDGET_ID=REPLACE_WITH_YOUR_MSG91_WIDGET_ID

# ─── Mock OTP — LOCAL TESTING ONLY ──────────────────────────────────────────
# MOCK_OTP=true makes the server accept OTP "123456" for ANY phone number.
# ⚠️  NEVER set this to true in production. The server prints a loud warning.
MOCK_OTP=false
# MOCK_OTP_CODE=123456

# ─── CORS (REQUIRED in production) ──────────────────────────────────────────
# Exact origin of the admin panel. If unset, the server logs a loud warning
# and falls back to "*" (any website could then call your API).
FRONTEND_URL=http://localhost:3000

# ─── Company UPI (for QR payments) ──────────────────────────────────────────
COMPANY_UPI_ID=namasteindia@upi
